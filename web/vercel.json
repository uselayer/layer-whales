{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/lyr/static/:path*", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/lyr/array/:path*", "destination": "https://us-assets.i.posthog.com/array/:path*" },
    { "source": "/lyr/:path*", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/(.*)", "destination": "https://signals-production-1eb7.up.railway.app/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
