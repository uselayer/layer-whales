{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/lyr/static/(.*)", "destination": "https://us-assets.i.posthog.com/static/$1" },
    { "source": "/lyr/array/(.*)", "destination": "https://us-assets.i.posthog.com/array/$1" },
    { "source": "/lyr/(.*)", "destination": "https://us.i.posthog.com/$1" },
    { "source": "/(.*)", "destination": "https://signals-production-1eb7.up.railway.app/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
